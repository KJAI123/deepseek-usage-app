<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 主应用本地开发使用非沙盒模式（ad-hoc 签名下 App Group / temporary-exception 均不生效，
         非沙盒可读写共享目录 ~/Library/Application Support/DeepSeekUsagePanel）。
         上架 App Store 时再启用 app-sandbox + application-groups（需 Apple Developer team id）。 -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
